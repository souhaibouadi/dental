<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_dental_appointment_reminder" model="mail.template">
            <field name="name">Dental: Appointment Reminder</field>
            <field name="model_id" ref="model_dental_appointment"/>
            <field name="subject">Appointment reminder - {{ object.name }}</field>
            <field name="email_from">{{ (object.practitioner_id.email or user.email or '') }}</field>
            <field name="email_to">{{ object.patient_id.email }}</field>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif">
    <p>Dear <t t-out="object.patient_id.name"/>,</p>
    <p>This is a friendly reminder of your dental appointment scheduled on
       <strong><t t-out="object.start"/></strong> with
       <strong>Dr. <t t-out="object.practitioner_id.name"/></strong>.</p>
    <p>If you cannot make it, please contact us as soon as possible.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
