<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dental_patient" model="ir.sequence">
            <field name="name">Dental Patient</field>
            <field name="code">dental.patient</field>
            <field name="prefix">PAT/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_appointment" model="ir.sequence">
            <field name="name">Dental Appointment</field>
            <field name="code">dental.appointment</field>
            <field name="prefix">APT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_treatment_plan" model="ir.sequence">
            <field name="name">Dental Treatment Plan</field>
            <field name="code">dental.treatment.plan</field>
            <field name="prefix">TP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dental_prescription" model="ir.sequence">
            <field name="name">Dental Prescription</field>
            <field name="code">dental.prescription</field>
            <field name="prefix">RX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
