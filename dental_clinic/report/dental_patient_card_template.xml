<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_dental_patient_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Patient Card</h2>
                        <table class="table table-sm">
                            <tr><th>Code</th><td t-field="o.code"/></tr>
                            <tr><th>Name</th><td t-field="o.name"/></tr>
                            <tr><th>Date of Birth</th><td t-field="o.birth_date"/></tr>
                            <tr><th>Gender</th><td t-field="o.gender"/></tr>
                            <tr><th>Blood Type</th><td t-field="o.blood_type"/></tr>
                            <tr><th>Phone</th><td t-field="o.phone"/></tr>
                            <tr><th>Mobile</th><td t-field="o.mobile"/></tr>
                            <tr><th>Email</th><td t-field="o.email"/></tr>
                            <tr><th>Address</th><td>
                                <span t-field="o.street"/>, <span t-field="o.city"/>
                                <span t-field="o.zip"/> <span t-field="o.country_id.name"/></td></tr>
                            <tr><th>Allergies</th><td t-field="o.allergies"/></tr>
                            <tr><th>Chronic Diseases</th><td t-field="o.chronic_diseases"/></tr>
                            <tr><th>Medications</th><td t-field="o.current_medications"/></tr>
                            <tr><th>Emergency</th>
                                <td><span t-field="o.emergency_name"/>
                                    (<span t-field="o.emergency_relation"/>) -
                                    <span t-field="o.emergency_phone"/></td></tr>
                        </table>
                        <h3 class="mt16">Odontogram</h3>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>#</th><th>Tooth</th><th>Quadrant</th>
                                    <th>Condition</th><th>Surface</th><th>Last Tx</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.tooth_ids" t-as="t">
                                    <td t-field="t.tooth_number"/>
                                    <td t-field="t.name"/>
                                    <td t-field="t.quadrant"/>
                                    <td t-field="t.condition"/>
                                    <td t-field="t.surface"/>
                                    <td t-field="t.last_treatment_date"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
