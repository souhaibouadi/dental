<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_prescription_tree" model="ir.ui.view">
        <field name="name">dental.prescription.tree</field>
        <field name="model">dental.prescription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="practitioner_id"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_dental_prescription_form" model="ir.ui.view">
        <field name="name">dental.prescription.form</field>
        <field name="model">dental.prescription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Print" class="btn-primary"
                            invisible="state == 'cancel'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancel'"/>
                    <button name="action_draft" type="object" string="Reset"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="practitioner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="appointment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnosis">
                            <field name="diagnosis"/>
                        </page>
                        <page string="Medications">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration"/>
                                    <field name="quantity"/>
                                    <field name="instructions"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Advice">
                            <field name="advice"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_dental_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">dental.prescription</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
