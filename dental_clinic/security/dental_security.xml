<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_dental" model="ir.module.category">
            <field name="name">Dental Clinic</field>
            <field name="description">Manage the dental clinic.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_dental_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="module_category_dental"/>
            <field name="comment">Can manage patients and appointments.</field>
        </record>

        <record id="group_dental_user" model="res.groups">
            <field name="name">Dentist / User</field>
            <field name="category_id" ref="module_category_dental"/>
            <field name="implied_ids" eval="[(4, ref('group_dental_receptionist'))]"/>
            <field name="comment">Dentists, hygienists.</field>
        </record>

        <record id="group_dental_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_dental"/>
            <field name="implied_ids" eval="[(4, ref('group_dental_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Full access including configuration.</field>
        </record>

        <!-- Record rules -->
        <record id="rule_dental_appointment_user" model="ir.rule">
            <field name="name">Practitioners see all appointments in their company</field>
            <field name="model_id" ref="model_dental_appointment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_dental_user'))]"/>
        </record>
    </data>
</odoo>
